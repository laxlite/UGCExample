{
    "version": "1.0.0",
    "description": "Install & build CSS library for ECGExample",
    "dependencies": {
        "@tailwindcss/cli": "4.3.3",
        "tailwindcss": "4.3.3"
    },
    "scripts": {
        "devBuild": "tailwindcss build -i ./css/input.css -o ../resources/static/css/index. --watch",
        "prodBuild": "tailwindcss build -i ./css/input.css -o ../resources/static/css/index.css --minify"
    }
}